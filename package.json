{
  "name": "taskhub",
  "version": "0.1.0",
  "private": true,
  "description": "Modular multi-user task management for Modig Machine Tool",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "shared",
    "api",
    "web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "node scripts/clean.mjs",
    "dev": "npm run dev --workspace web",
    "dev:api": "npm run start --workspace api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --build --force",
    "verify": "node scripts/verify.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^4.1.10",
    "azurite": "^3.36.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
