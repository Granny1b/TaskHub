# TaskHub configuration.
#
# No secrets live in this repository. In Azure these are set as Static Web Apps
# application settings (Configuration blade, or `az staticwebapp appsettings set`).
# Locally, copy the API values into api/local.settings.json, which is gitignored.

# ---------------------------------------------------------------------------
# Storage credentials — set exactly one of the two blocks below.
# ---------------------------------------------------------------------------

# Option A (v1, what we actually run on).
# SWA-managed Functions cannot use managed identity to reach Blob Storage —
# verified against current Microsoft guidance, see docs/VERIFICATION.md — so v1
# authenticates with a connection string held in SWA application settings.
# Rotate it from the storage account's "Access keys" blade.
AZURE_STORAGE_CONNECTION_STRING=

# Option B (preferred posture, available once the API moves to a standalone
# Functions app). Set the account URL instead and the code uses
# DefaultAzureCredential — no secret anywhere. If both are set, this one wins.
# AZURE_STORAGE_ACCOUNT_URL=https://sttaskhubprod.blob.core.windows.net

# ---------------------------------------------------------------------------
# Local development against Azurite (the blob emulator).
# ---------------------------------------------------------------------------
# Start it with:  npx azurite --silent --location ./.azurite
# Then use the well-known development connection string:
# AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# ---------------------------------------------------------------------------
# Frontend. Vite only exposes variables prefixed with VITE_ to the browser,
# so nothing sensitive can leak into the bundle by accident.
# ---------------------------------------------------------------------------
# Base path for API calls. Empty means same-origin /api, which is how SWA works
# in production and how the Vite dev proxy is configured. Override only for an
# unusual local setup.
VITE_API_BASE_URL=
